# Optional override. The current prototype target is supplied by the operator.
ROCK4D_SSH_HOST=qqice@rock4d.example

# Dedicated runtime directory in the remote user's home.
OPENFRAMETAP_REMOTE_DIR=~/openframetap-runtime
# Keep real values in environment variables or ~/.config/openframetap/secrets.env (0600).
OPENFRAMETAP_WIFI_SSID=
OPENFRAMETAP_WIFI_PSK=
OPENFRAMETAP_RTMP_STREAM_KEY=
POCKET3_BLE_ADDRESS=
